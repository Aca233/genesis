// 《创世》数据模型 —— 见 docs/03-数据模型.md
// 单用户期 user_id 恒为 "local"，为后续 Discord OAuth 预留。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── 世界与时间线 ─────────────────────────

model World {
  id                 String     @id @default(cuid())
  userId             String     @default("local") @map("user_id")
  name               String
  genesisInput       String     @map("genesis_input") // 原初神谕
  mode               String     @default("pantheon")
  status             String     @default("draft") // draft | playing | concluded
  draftDeck          Json?      @map("draft_deck") // 创世草稿卡组（开局落地后清空）
  lockedPaths        String[]   @map("locked_paths") // 卡片编辑器 player_locked 字段路径
  themeCard          Json?      @map("theme_card") // 纪年名/位阶命名/措辞
  styleCard          Json?      @map("style_card") // 叙事风格卡
  cosmology          Json? // 宇宙论卡
  fusionAxiom        Json?      @map("fusion_axiom") // 融合公理卡（仅多IP融合）
  activeTimelineId   String?    @map("active_timeline_id")
  operationKind      String?    @map("operation_kind")
  operationToken     String?    @map("operation_token")
  operationLeaseExpiresAt DateTime? @map("operation_lease_expires_at")
  timelines          Timeline[]
  rewrites           RealityRewrite[]
  lorebookEntries    LorebookEntry[]
  genesisTasks       GenesisTask[]
  materialCards      MaterialCard[]
  materialArchiveStatus String   @default("pending") @map("material_archive_status")
  materialArchiveError  String?  @map("material_archive_error")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("worlds")
}

model GenesisTask {
  id             String    @id @default(cuid())
  userId         String    @default("local") @map("user_id")
  decree         String
  lorebook       Json?
  lorebookName   String?   @map("lorebook_name")
  materialSelection Json?  @map("material_selection")
  mode           String    @default("pantheon")
  status         String    @default("queued") // queued | running | repairing | completed | failed
  stage          String    @default("oracle")
  completedKeys  String[]  @map("completed_keys")
  rawOutput      String    @default("") @map("raw_output") @db.Text
  error          String?
  attempt        Int       @default(0)
  leaseToken     String?   @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  worldId        String?   @unique @map("world_id")
  world          World?    @relation(fields: [worldId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, leaseExpiresAt])
  @@map("genesis_tasks")
}

model Timeline {
  id          String           @id @default(cuid())
  worldId     String           @map("world_id")
  world       World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parentId    String?          @map("parent_id") // 自哪条时间线分叉（M3）
  forkChapter Int?             @map("fork_chapter")
  branchName      String            @default("原初现实") @map("branch_name")
  branchSummary   String?           @map("branch_summary")
  realityState    Json?             @map("reality_state")
  observerState   Json?             @map("observer_state")
  forkRewriteId   String?           @unique @map("fork_rewrite_id")
  forkRewrite     RealityRewrite?   @relation("TimelineForkRewrite", fields: [forkRewriteId], references: [id], onDelete: SetNull)
  sourceRewrites  RealityRewrite[]  @relation("RewriteSource")
  resultRewrite   RealityRewrite?   @relation("RewriteResult")
  chapters    Chapter[]
  gods        God[]
  entities    Entity[]
  abilities   Ability[]
  chronicles  ChronicleEntry[]
  omens       OmenQueue[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([worldId])
  @@map("timelines")
}

model Chapter {
  id          String    @id @default(cuid())
  timelineId  String    @map("timeline_id")
  timeline    Timeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  index       Int
  title       String?
  summary     String? // 章末史官小结
  settleState String    @default("open") @map("settle_state") // open | settling:<step> | settled
  snapshot    Json? // 章快照（M3 分叉用）
  messages      Message[]
  abilityEvents AbilityEvent[]
  generationRequests GenerationRequest[]
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([timelineId, index])
  @@map("chapters")
}

model GenerationRequest {
  id                String   @id
  chapterId         String   @map("chapter_id")
  chapter           Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  mode              String
  scale             String
  content           String?
  directive         String?
  status            String   @default("pending")
  error             String?
  attempt           Int      @default(1)
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  playerMessageId   String?  @map("player_message_id")
  narratorMessageId String   @map("narrator_message_id")
  playerIndex       Int?     @map("player_index")
  narratorIndex     Int      @map("narrator_index")
  resultMeta        Json?    @map("result_meta")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([chapterId, status])
  @@map("generation_requests")
}

model Message {
  id        String   @id @default(cuid())
  chapterId String   @map("chapter_id")
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  index     Int
  role      String // player | narrator
  content   String
  scale     String   @default("scene") // scene | era | epoch
  variants  Json? // 异文候选 [{content, chosen}]
  meta          Json? // 建议/揭示事件/实体链接span/edited标记
  abilityEvents AbilityEvent[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([chapterId, index])
  @@map("messages")
}

// ───────────────────────── 诸神 ─────────────────────────

model God {
  id             String   @id @default(cuid())
  timelineId     String   @map("timeline_id")
  timeline       Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  name           String
  aliases        String[] // 检索用：别名+称号
  tier           String // major | minor | player
  isPlayer       Boolean  @default(false) @map("is_player")
  rank           String   @default("nascent") // ember..sovereign 内部枚举，主题卡负责措辞映射
  domains        String[] // 领域关键词
  persona        Json? // 人格卡（可见）
  voice          Json? // 声纹卡（可见）
  agenda         Json? // 议程卡（默认隐藏）
  agendaRevealed Boolean  @default(false) @map("agenda_revealed")
  relations      Json? // { targetId: {label, note} }
  faithScope     String?  @map("faith_scope")
  materialRef    String?  @map("material_ref")
  codexEntityId  String?    @map("codex_entity_id")
  abilities      Ability[] @relation("GodAbilities")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([timelineId])
  @@unique([timelineId, materialRef])
  @@map("gods")
}

// ───────────────────────── 百科（Codex）─────────────────────────

model Entity {
  id            String          @id @default(cuid())
  timelineId    String          @map("timeline_id")
  timeline      Timeline        @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  type          String // faction | character | race | place | artifact | cult
  name          String
  aliases       String[]
  emblemSeed    String          @map("emblem_seed") // 程序纹章种子
  imageUrl      String?         @map("image_url") // 玩家上传；预留 AI 生图
  starred          Boolean            @default(false)
  isChosen         Boolean            @default(false) @map("is_chosen") // 神选者：永不降档/压缩
  isMajorCharacter Boolean            @default(false) @map("is_major_character")
  isCreatorAvatar  Boolean            @default(false) @map("is_creator_avatar")
  raceId           String?            @map("race_id")
  race             Entity?            @relation("CharacterRace", fields: [raceId], references: [id], onDelete: SetNull)
  raceMembers      Entity[]           @relation("CharacterRace")
  heat          String          @default("active") // active | dormant
  scenePresence Boolean         @default(false) @map("scene_presence")
  summary       String // 摘要卡（dormant 时的全部）
  lockedPaths   String[]        @map("locked_paths") // player_locked 字段路径
  materialRef   String?         @map("material_ref")
  sections              EntitySection[]
  abilities             Ability[]         @relation("EntityAbilities")
  memberships           EntityMembership[] @relation("MembershipCharacter")
  membershipsAsFaction  EntityMembership[] @relation("MembershipFaction")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([timelineId, type])
  @@unique([timelineId, materialRef])
  @@map("entities")
}

model RealityRewrite {
  id                 String    @id @default(cuid())
  worldId            String    @map("world_id")
  world              World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  sourceTimelineId   String    @map("source_timeline_id")
  sourceTimeline     Timeline  @relation("RewriteSource", fields: [sourceTimelineId], references: [id], onDelete: Restrict)
  resultTimelineId   String?   @unique @map("result_timeline_id")
  resultTimeline     Timeline? @relation("RewriteResult", fields: [resultTimelineId], references: [id], onDelete: SetNull)
  forkedTimeline     Timeline? @relation("TimelineForkRewrite")
  sourceChapterId    String    @map("source_chapter_id")
  decree             String    @db.Text
  scope              String    @default("prospective")
  status             String    @default("planning")
  plan               Json?
  summary            String?
  idempotencyKey     String    @unique @map("idempotency_key")
  leaseToken         String?   @map("lease_token")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  error              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([worldId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("reality_rewrites")
}

model Ability {
  id              String          @id @default(cuid())
  timelineId      String          @map("timeline_id")
  timeline        Timeline        @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  entityId        String?         @map("entity_id")
  entity          Entity?         @relation("EntityAbilities", fields: [entityId], references: [id], onDelete: Cascade)
  godId           String?         @map("god_id")
  god             God?            @relation("GodAbilities", fields: [godId], references: [id], onDelete: Cascade)
  sourceAbilityId String?         @map("source_ability_id")
  sourceAbility   Ability?        @relation("AbilitySource", fields: [sourceAbilityId], references: [id], onDelete: SetNull)
  derivedAbilities Ability[]      @relation("AbilitySource")
  name            String
  kind            String
  effect          String
  trigger         String
  cost            String
  limitations     String
  mastery         String
  state           String          @default("normal")
  visibility      String          @default("known")
  rumorText       String?         @map("rumor_text")
  bloodlineJustification String?         @map("bloodline_justification")
  lockedFields    String[]        @map("locked_fields")
  version         Int             @default(1)
  materialRef     String?         @map("material_ref")
  events          AbilityEvent[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([timelineId])
  @@index([entityId])
  @@index([godId])
  @@index([sourceAbilityId])
  @@unique([timelineId, materialRef])
  @@unique([entityId, sourceAbilityId])
  @@map("abilities")
}

model AbilityEvent {
  id        String   @id @default(cuid())
  abilityId String   @map("ability_id")
  ability   Ability  @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  chapterId String   @map("chapter_id")
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  messageId String?  @map("message_id")
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  type      String
  before    Json?
  after     Json?
  evidence  String
  scale     String
  dedupeKey String   @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([abilityId, createdAt])
  @@index([chapterId])
  @@index([messageId])
  @@map("ability_events")
}

model EntityMembership {
  id          String @id @default(cuid())
  characterId String @map("character_id")
  character   Entity @relation("MembershipCharacter", fields: [characterId], references: [id], onDelete: Cascade)
  factionId   String @map("faction_id")
  faction     Entity @relation("MembershipFaction", fields: [factionId], references: [id], onDelete: Cascade)
  role        String
  isPrimary   Boolean @default(false) @map("is_primary")

  @@unique([characterId, factionId])
  @@index([factionId])
  @@map("entity_memberships")
}

model EntitySection {
  id           String  @id @default(cuid())
  entityId     String  @map("entity_id")
  entity       Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  key          String // 栏目键，受类型模板约束
  content      Json
  revealed     Boolean @default(true) // false → 传闻/经卷残缺
  rumorText    String? @map("rumor_text") // 未揭示时的传闻（可误导）
  playerLocked Boolean @default(false) @map("player_locked")

  @@unique([entityId, key])
  @@map("entity_sections")
}

// ───────────────────────── 编年史 ─────────────────────────

model ChronicleEntry {
  id                String   @id @default(cuid())
  timelineId        String   @map("timeline_id")
  timeline          Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  chapterIndex      Int      @map("chapter_index")
  yearLabel         String   @map("year_label") // 主题卡纪年体系
  text              String // 史官笔法
  entityIds         String[] @map("entity_ids")
  godIds            String[] @map("god_ids")
  revealed          Boolean  @default(true) // false = 诸神隐藏行动
  revealedAtChapter Int?     @map("revealed_at_chapter")
  source            String   @default("narrative") // narrative | pantheon | manual
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([timelineId, chapterIndex])
  @@map("chronicle_entries")
}

model OmenQueue {
  id         String   @id @default(cuid())
  timelineId String   @map("timeline_id")
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  godId      String   @map("god_id")
  text       String // 征兆：将润物细无声织入下章
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([timelineId, consumed])
  @@map("omen_queue")
}

// ───────────────────────── 世界书（ST 兼容）─────────────────────────

model LorebookEntry {
  id      String   @id @default(cuid())
  worldId String   @map("world_id")
  world   World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  keys    String[] // ST 触发词
  content String
  enabled Boolean  @default(true)
  stExtra Json?    @map("st_extra") // 保留 ST 原始字段，导出还原
  source  String   @default("imported") // imported | generated

  @@index([worldId])
  @@map("lorebook_entries")
}


// ───────────────────────── 创世素材库 ─────────────────────────

model MaterialCard {
  id               String            @id @default(cuid())
  userId           String            @default("local") @map("user_id")
  kind             String
  name             String
  summary          String
  favorite         Boolean           @default(false)
  hidden           Boolean           @default(false)
  sourceWorldId    String?           @map("source_world_id")
  sourceWorld      World?            @relation(fields: [sourceWorldId], references: [id], onDelete: SetNull)
  sourceWorldName  String            @map("source_world_name")
  sourceKind       String            @map("source_kind")
  sourceRef        String            @map("source_ref")
  defaultVersionId String?           @map("default_version_id")
  versions         MaterialVersion[] @relation("MaterialCardVersions")
  defaultVersion   MaterialVersion?  @relation("MaterialDefaultVersion", fields: [defaultVersionId], references: [id], onDelete: SetNull)
  lastUsedAt       DateTime?         @map("last_used_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([userId, sourceKind, sourceRef])
  @@index([userId, favorite, hidden, updatedAt])
  @@index([sourceWorldId])
  @@map("material_cards")
}

model MaterialVersion {
  id              String            @id @default(cuid())
  cardId          String            @map("card_id")
  card            MaterialCard      @relation("MaterialCardVersions", fields: [cardId], references: [id], onDelete: Cascade)
  defaultForCards MaterialCard[]     @relation("MaterialDefaultVersion")
  version         Int
  name            String
  note            String?
  content         Json
  dependencies    Json
  schemaVersion   Int               @default(1) @map("schema_version")
  isInitial       Boolean           @default(false) @map("is_initial")
  parentVersionId String?           @map("parent_version_id")
  parentVersion   MaterialVersion?  @relation("MaterialVersionParents", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   MaterialVersion[] @relation("MaterialVersionParents")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([cardId, version])
  @@index([parentVersionId])
  @@map("material_versions")
}

// ───────────────────────── 设置与日志 ─────────────────────────

model Settings {
  userId        String   @id @default("local") @map("user_id")
  narrativeSlot Json?    @map("narrative_slot") // ModelSlot（key 为 AES-256-GCM 密文）
  backstageSlot Json?    @map("backstage_slot")
  embeddingSlot Json?    @map("embedding_slot")
  prefs         Json? // 建议开关/翻章建议/烛光模式/文风预设
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model LlmCall {
  id               String   @id @default(cuid())
  task             String // narrative | genesis | settlement | reroll | pantheon | extract | chronicle | test
  slot             String // narrative | backstage
  provider         String?
  model            String?
  durationMs       Int      @map("duration_ms")
  ok               Boolean
  error            String?
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  cacheReadTokens  Int?     @map("cache_read_tokens")
  cacheWriteTokens Int?     @map("cache_write_tokens")
  cacheRequested   Boolean  @default(false) @map("cache_requested")
  cacheFallback    Boolean  @default(false) @map("cache_fallback")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([task, createdAt])
  @@map("llm_calls")
}
