// 《创世》数据模型 —— 见 docs/03-数据模型.md
// 多用户：5 张属主表经 user_id 外键归属 better-auth 的 "user" 表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── 身份与会话（better-auth）─────────────────────────

model User {
  id               String           @id
  name             String
  email            String
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  worlds           World[]
  genesisTasks     GenesisTask[]
  materialCards    MaterialCard[]
  loreIndexEntries LoreIndexEntry[]
  settings         Settings?
  adminAuditLogs   AdminAuditLog[]  @relation("AdminAuditActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ───────────────────────── 世界与时间线 ─────────────────────────

model World {
  id                      String           @id @default(cuid())
  userId                  String           @map("user_id")
  user                    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  name                    String
  genesisInput            String           @map("genesis_input") // 原初神谕
  genesisIntent           Json?            @map("genesis_intent")
  mode                    String           @default("pantheon")
  status                  String           @default("draft") // draft | playing | concluded
  draftDeck               Json?            @map("draft_deck") // 创世草稿卡组（开局落地后清空）
  lockedPaths             String[]         @map("locked_paths") // 卡片编辑器 player_locked 字段路径
  themeCard               Json?            @map("theme_card") // 纪年名/位阶命名/措辞
  styleCard               Json?            @map("style_card") // 叙事风格卡
  cosmology               Json? // 宇宙论卡
  fusionAxiom             Json?            @map("fusion_axiom") // 融合公理卡（仅多IP融合）
  iconTheme               Json?            @map("icon_theme")
  iconThemeRevision       Int              @default(0) @map("icon_theme_revision")
  iconThemeOperationKey   String?          @map("icon_theme_operation_key")
  activeTimelineId        String?          @map("active_timeline_id")
  operationKind           String?          @map("operation_kind")
  operationToken          String?          @map("operation_token")
  operationLeaseExpiresAt DateTime?        @map("operation_lease_expires_at")
  timelines               Timeline[]
  rewrites                RealityRewrite[]
  lorebookEntries         LorebookEntry[]
  genesisTasks            GenesisTask[]
  materialCards           MaterialCard[]
  materialArchiveStatus   String           @default("pending") @map("material_archive_status")
  materialArchiveError    String?          @map("material_archive_error")
  archivedAt              DateTime?        @map("archived_at")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@map("worlds")
}

model GenesisTask {
  id                      String            @id @default(cuid())
  userId                  String            @map("user_id")
  user                    User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey          String?           @map("idempotency_key")
  requestHash             String?           @map("request_hash")
  engineVersion           String            @default("legacy-v1") @map("engine_version")
  aggregateVersion        Int               @default(1) @map("aggregate_version")
  budgetMaxCalls          Int               @default(12) @map("budget_max_calls")
  budgetMaxInput          Int               @default(500000) @map("budget_max_input_tokens")
  budgetMaxOutput         Int               @default(65536) @map("budget_max_output_tokens")
  budgetCallCount         Int               @default(0) @map("budget_call_count")
  budgetReservedIn        Int               @default(0) @map("budget_reserved_input_tokens")
  budgetReservedOut       Int               @default(0) @map("budget_reserved_output_tokens")
  budgetSettledIn         Int               @default(0) @map("budget_settled_input_tokens")
  budgetSettledOut        Int               @default(0) @map("budget_settled_output_tokens")
  shadowEnabled           Boolean           @default(false) @map("shadow_enabled")
  shadowStatus            String            @default("disabled") @map("shadow_status")
  preflight               Json?
  preflightHash           String?           @map("preflight_hash")
  shadowPreflight         Json?             @map("shadow_preflight")
  shadowPreflightHash     String?           @map("shadow_preflight_hash")
  shadowBudgetMaxCalls    Int               @default(5) @map("shadow_budget_max_calls")
  shadowBudgetMaxInput    Int               @default(120000) @map("shadow_budget_max_input_tokens")
  shadowBudgetMaxOutput   Int               @default(30000) @map("shadow_budget_max_output_tokens")
  shadowBudgetCallCount   Int               @default(0) @map("shadow_budget_call_count")
  shadowBudgetReservedIn  Int               @default(0) @map("shadow_budget_reserved_input_tokens")
  shadowBudgetReservedOut Int               @default(0) @map("shadow_budget_reserved_output_tokens")
  shadowBudgetSettledIn   Int               @default(0) @map("shadow_budget_settled_input_tokens")
  shadowBudgetSettledOut  Int               @default(0) @map("shadow_budget_settled_output_tokens")
  decree                  String
  intentContract          Json?             @map("intent_contract")
  lorebook                Json?
  lorebookName            String?           @map("lorebook_name")
  materialSelection       Json?             @map("material_selection")
  mode                    String            @default("pantheon")
  status                  String            @default("queued") // queued | running | repairing | completed | failed
  stage                   String            @default("oracle")
  completedKeys           String[]          @map("completed_keys")
  rawOutput               String            @default("") @map("raw_output") @db.Text
  rawExpiresAt            DateTime?         @map("raw_expires_at")
  error                   String?
  /**
   * 时间一致设计稿 §10.4：报告型 AI 语义审计结果（TemporalAuditResult）；仅 IP 世界产出，审计失败/旧任务为 NULL
   */
  auditReport             Json?             @map("audit_report")
  attempt                 Int               @default(0)
  leaseToken              String?           @map("lease_token")
  leaseExpiresAt          DateTime?         @map("lease_expires_at")
  worldId                 String?           @unique @map("world_id")
  world                   World?            @relation(fields: [worldId], references: [id], onDelete: SetNull)
  jobs                    GenesisJob[]
  outboxEvents            GenesisOutbox[]
  llmAttempts             LlmAttempt[]
  artifacts               GenesisArtifact[]
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([rawExpiresAt])
  @@index([status, leaseExpiresAt])
  @@map("genesis_tasks")
}

model GenesisJob {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  genesisTaskId     String            @map("genesis_task_id")
  task              GenesisTask       @relation(fields: [genesisTaskId], references: [id], onDelete: Cascade)
  nodeKey           String            @map("node_key")
  engineVersion     String            @map("engine_version")
  priority          Int               @default(0)
  status            String            @default("queued")
  dependencyKeys    String[]          @default([]) @map("dependency_keys")
  inputHash         String?           @map("input_hash")
  leaseToken        String?           @map("lease_token")
  leaseEpoch        Int               @default(0) @map("lease_epoch")
  leaseExpiresAt    DateTime?         @map("lease_expires_at")
  attempt           Int               @default(0)
  estimatedDuration Int?              @map("estimated_duration")
  estimatedTokens   Int?              @map("estimated_tokens")
  startedAt         DateTime?         @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  error             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  llmAttempts       LlmAttempt[]
  artifacts         GenesisArtifact[]

  @@unique([genesisTaskId, nodeKey])
  @@index([status, priority, createdAt])
  @@index([userId, status])
  @@index([leaseExpiresAt])
  @@map("genesis_jobs")
}

model LlmSlot {
  slotNo           Int         @id @map("slot_no")
  currentAttemptId String?     @unique @map("current_attempt_id")
  slotEpoch        Int         @default(0) @map("slot_epoch")
  boundAt          DateTime?   @map("bound_at")
  currentAttempt   LlmAttempt? @relation("CurrentLlmSlotAttempt", fields: [currentAttemptId], references: [id], onDelete: Restrict)

  @@map("llm_slots")
}

model LlmAttempt {
  id                   String       @id @default(cuid())
  logicalCallId        String       @map("logical_call_id")
  physicalAttemptIndex Int          @map("physical_attempt_index")
  usedSlotNo           Int          @map("used_slot_no")
  slotEpoch            Int          @map("slot_epoch")
  cacheIsolationDomain String       @map("cache_isolation_domain")
  endpointKey          String       @map("endpoint_key")
  model                String
  taskClass            String       @map("task_class")
  ownerKind            String       @map("owner_kind")
  ownerId              String       @map("owner_id")
  genesisTaskId        String?      @map("genesis_task_id")
  genesisTask          GenesisTask? @relation(fields: [genesisTaskId], references: [id], onDelete: SetNull)
  genesisJobId         String?      @map("genesis_job_id")
  genesisJob           GenesisJob?  @relation(fields: [genesisJobId], references: [id], onDelete: SetNull)
  userId               String       @map("user_id")
  leaseEpoch           Int?         @map("lease_epoch")
  budgetScope          String       @default("primary") @map("budget_scope")
  state                String       @default("reserved")
  transportKind        String       @map("transport_kind")
  transportOutcome     String?      @map("transport_outcome")
  terminalEvidence     String?      @map("terminal_evidence")
  stableErrorCode      String?      @map("stable_error_code")
  reservedInputTokens  Int          @map("reserved_input_tokens")
  reservedOutputTokens Int          @map("reserved_output_tokens")
  settledInputTokens   Int?         @map("settled_input_tokens")
  settledOutputTokens  Int?         @map("settled_output_tokens")
  inputTokens          Int?         @map("input_tokens")
  outputTokens         Int?         @map("output_tokens")
  cacheReadTokens      Int?         @map("cache_read_tokens")
  cacheWriteTokens     Int?         @map("cache_write_tokens")
  acquiredAt           DateTime     @default(now()) @map("acquired_at")
  ownerLeaseExpiresAt  DateTime?    @map("owner_lease_expires_at")
  hardCallDeadline     DateTime?    @map("hard_call_deadline")
  heartbeatAt          DateTime?    @map("heartbeat_at")
  providerStartedAt    DateTime?    @map("provider_started_at")
  providerFinishedAt   DateTime?    @map("provider_finished_at")
  releasedAt           DateTime?    @map("released_at")
  error                String?
  currentSlot          LlmSlot?     @relation("CurrentLlmSlotAttempt")

  @@unique([logicalCallId, physicalAttemptIndex])
  @@index([state, acquiredAt])
  @@index([endpointKey, model, taskClass, state])
  @@index([userId, state])
  @@index([genesisTaskId, state])
  @@map("llm_attempts")
}

model LlmPermitRequest {
  id                   String    @id @default(cuid())
  logicalCallId        String    @map("logical_call_id")
  physicalAttemptIndex Int       @map("physical_attempt_index")
  userId               String    @map("user_id")
  taskClass            String    @map("task_class")
  priority             Int
  endpointKey          String    @map("endpoint_key")
  model                String
  cacheIsolationDomain String    @map("cache_isolation_domain")
  state                String    @default("waiting")
  requestedAt          DateTime  @default(now()) @map("requested_at")
  acquiredAt           DateTime? @map("acquired_at")
  cancelledAt          DateTime? @map("cancelled_at")

  @@unique([logicalCallId, physicalAttemptIndex])
  @@index([state, priority, requestedAt])
  @@index([userId, state])
  @@map("llm_permit_requests")
}

model GenesisArtifact {
  id               String      @id @default(cuid())
  genesisTaskId    String      @map("genesis_task_id")
  task             GenesisTask @relation(fields: [genesisTaskId], references: [id], onDelete: Cascade)
  genesisJobId     String?     @map("genesis_job_id")
  job              GenesisJob? @relation(fields: [genesisJobId], references: [id], onDelete: SetNull)
  stageKey         String      @map("stage_key")
  version          Int
  status           String      @default("candidate")
  visibility       String      @default("shadow")
  inputHash        String      @map("input_hash")
  outputHash       String      @map("output_hash")
  reuseKey         String      @map("reuse_key")
  dependencyHashes String[]    @default([]) @map("dependency_hashes")
  content          Json
  validation       Json?
  acceptedAt       DateTime?   @map("accepted_at")
  supersededAt     DateTime?   @map("superseded_at")
  sealedAt         DateTime?   @map("sealed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@unique([genesisTaskId, stageKey, version])
  @@index([genesisTaskId, stageKey, status])
  @@index([reuseKey, status])
  @@map("genesis_artifacts")
}

model LlmFairness {
  userId        String    @id @map("user_id")
  virtualFinish Float     @default(0) @map("virtual_finish")
  lastGrantedAt DateTime? @map("last_granted_at")

  @@map("llm_fairness")
}

model LlmCircuit {
  circuitKey      String    @id @map("circuit_key")
  endpointKey     String    @map("endpoint_key")
  model           String
  taskClass       String    @map("task_class")
  state           String    @default("closed")
  failureCount    Int       @default(0) @map("failure_count")
  openUntil       DateTime? @map("open_until")
  probeRequestId  String?   @map("probe_request_id")
  lastFailureCode String?   @map("last_failure_code")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([state, openUntil])
  @@map("llm_circuits")
}

model GenesisOutbox {
  eventId           String      @id @default(cuid()) @map("event_id")
  taskId            String      @map("task_id")
  task              GenesisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  aggregateVersion  Int         @map("aggregate_version")
  eventType         String      @map("event_type")
  payloadProjection Json        @map("payload_projection")
  createdAt         DateTime    @default(now()) @map("created_at")
  publishedAt       DateTime?   @map("published_at")
  deliveryAttempts  Int         @default(0) @map("delivery_attempts")

  @@unique([taskId, aggregateVersion])
  @@index([taskId, createdAt])
  @@index([publishedAt, createdAt])
  @@map("genesis_outbox")
}

model Timeline {
  id              String           @id @default(cuid())
  worldId         String           @map("world_id")
  world           World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parentId        String?          @map("parent_id") // 自哪条时间线分叉（M3）
  forkChapter     Int?             @map("fork_chapter")
  branchName      String           @default("原初现实") @map("branch_name")
  branchSummary   String?          @map("branch_summary")
  realityState    Json?            @map("reality_state")
  observerState   Json?            @map("observer_state")
  forkRewriteId   String?          @unique @map("fork_rewrite_id")
  forkRewrite     RealityRewrite?  @relation("TimelineForkRewrite", fields: [forkRewriteId], references: [id], onDelete: SetNull)
  sourceRewrites  RealityRewrite[] @relation("RewriteSource")
  resultRewrite   RealityRewrite?  @relation("RewriteResult")
  chapters        Chapter[]
  gods            God[]
  entities        Entity[]
  abilities       Ability[]
  chronicles      ChronicleEntry[]
  omens           OmenQueue[]
  canonEvents     CanonEvent[]
  worldEvents     WorldEvent[]
  worldActivities WorldActivity[]
  entityRelations EntityRelation[]
  iconAssignments IconAssignment[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([worldId])
  @@map("timelines")
}

model Chapter {
  id                 String              @id @default(cuid())
  timelineId         String              @map("timeline_id")
  timeline           Timeline            @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  index              Int
  title              String?
  summary            String? // 章末史官小结
  brief              Json?   // 章节级目标、视角与信息控制合同
  settleState        String              @default("open") @map("settle_state") // open | settling:<step> | settled
  settleError        String?             @map("settle_error")
  settleRetryable    Boolean             @default(true) @map("settle_retryable")
  settleUpdatedAt    DateTime            @default(now()) @map("settle_updated_at")
  snapshot           Json? // 章快照（M3 分叉用）
  messages           Message[]
  abilityEvents      AbilityEvent[]
  generationRequests GenerationRequest[]
  createdAt          DateTime            @default(now()) @map("created_at")

  @@unique([timelineId, index])
  @@map("chapters")
}

model GenerationRequest {
  id                String    @id
  chapterId         String    @map("chapter_id")
  chapter           Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  mode              String
  scale             String
  content           String?
  directive         String?
  status            String    @default("pending")
  stage             String    @default("reserved")
  outputSnapshot    Json?     @map("output_snapshot")
  retryable         Boolean   @default(true)
  safeError         String?   @map("safe_error")
  stageUpdatedAt    DateTime  @default(now()) @map("stage_updated_at")
  error             String?
  attempt           Int       @default(1)
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  playerMessageId   String?   @map("player_message_id")
  narratorMessageId String    @map("narrator_message_id")
  playerIndex       Int?      @map("player_index")
  narratorIndex     Int       @map("narrator_index")
  resultMeta        Json?     @map("result_meta")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([chapterId, status])
  @@index([chapterId, stage])
  @@map("generation_requests")
}

model IconAssignment {
  id           String   @id @default(cuid())
  timelineId   String   @map("timeline_id")
  timeline     Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  subjectType  String   @map("subject_type")
  subjectId    String   @map("subject_id")
  token        String
  source       String
  playerLocked Boolean  @default(false) @map("player_locked")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([timelineId, subjectType, subjectId])
  @@index([timelineId])
  @@map("icon_assignments")
}

model WorldEvent {
  id               String          @id
  timelineId       String          @map("timeline_id")
  timeline         Timeline        @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  kind             String
  title            String
  summary          String          @db.Text
  phase            String
  visibility       String
  participantIds   String[]        @map("participant_ids")
  originMessageId  String          @map("origin_message_id")
  originActivityId String?         @map("origin_activity_id")
  latestMessageId  String          @map("latest_message_id")
  parentEventId    String?         @map("parent_event_id")
  parentEvent      WorldEvent?     @relation("EventChildren", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents      WorldEvent[]    @relation("EventChildren")
  activities       WorldActivity[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  resolvedAt       DateTime?       @map("resolved_at")

  @@index([timelineId, phase, updatedAt])
  @@map("world_events")
}

model WorldActivity {
  id              String      @id
  timelineId      String      @map("timeline_id")
  timeline        Timeline    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  eventId         String?     @map("event_id")
  event           WorldEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recordType      String      @map("record_type")
  kind            String
  text            String      @db.Text
  visibility      String
  actorId         String?     @map("actor_id")
  targetIds       String[]    @map("target_ids")
  subjectIds      String[]    @map("subject_ids")
  sourceMessageId String      @map("source_message_id")
  eraLabel        String      @map("era_label")
  timeLabel       String      @map("time_label")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([timelineId, createdAt])
  @@index([eventId, createdAt])
  @@map("world_activities")
}

model Message {
  id            String         @id @default(cuid())
  chapterId     String         @map("chapter_id")
  chapter       Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  index         Int
  role          String // player | narrator
  content       String
  scale         String         @default("scene") // scene | era | epoch
  variants      Json? // 异文候选 [{content, chosen}]
  meta          Json? // 建议/揭示事件/实体链接span/edited标记
  abilityEvents AbilityEvent[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@unique([chapterId, index])
  @@map("messages")
}

// ───────────────────────── 诸神 ─────────────────────────

model God {
  id             String    @id @default(cuid())
  timelineId     String    @map("timeline_id")
  timeline       Timeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  name           String
  aliases        String[] // 检索用：别名+称号
  tier           String // major | minor | player
  isPlayer       Boolean   @default(false) @map("is_player")
  rank           String    @default("nascent") // ember..sovereign 内部枚举，主题卡负责措辞映射
  domains        String[] // 领域关键词
  persona        Json? // 人格卡（可见）
  voice          Json? // 声纹卡（可见）
  agenda         Json? // 议程卡（默认隐藏）
  agendaRevealed Boolean   @default(false) @map("agenda_revealed")
  relations      Json? // { targetId: {label, note} }
  faithScope     String?   @map("faith_scope")
  materialRef    String?   @map("material_ref")
  codexEntityId  String?   @map("codex_entity_id")
  abilities      Ability[] @relation("GodAbilities")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([timelineId, materialRef])
  @@index([timelineId])
  @@map("gods")
}

// ───────────────────────── 百科（Codex）─────────────────────────

model Entity {
  id                   String             @id @default(cuid())
  timelineId           String             @map("timeline_id")
  timeline             Timeline           @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  type                 String // faction | character | race | place | artifact | cult
  name                 String
  aliases              String[]
  emblemSeed           String             @map("emblem_seed") // 程序纹章种子
  imageUrl             String?            @map("image_url") // 玩家上传；预留 AI 生图
  starred              Boolean            @default(false)
  isChosen             Boolean            @default(false) @map("is_chosen") // 神选者：永不降档/压缩
  isMajorCharacter     Boolean            @default(false) @map("is_major_character")
  isCreatorAvatar      Boolean            @default(false) @map("is_creator_avatar")
  raceId               String?            @map("race_id")
  race                 Entity?            @relation("CharacterRace", fields: [raceId], references: [id], onDelete: SetNull)
  raceMembers          Entity[]           @relation("CharacterRace")
  heat                 String             @default("active") // active | dormant
  scenePresence        Boolean            @default(false) @map("scene_presence")
  summary              String // 摘要卡（dormant 时的全部）
  lockedPaths          String[]           @map("locked_paths") // player_locked 字段路径
  materialRef          String?            @map("material_ref")
  sections             EntitySection[]
  abilities            Ability[]          @relation("EntityAbilities")
  memberships          EntityMembership[] @relation("MembershipCharacter")
  membershipsAsFaction EntityMembership[] @relation("MembershipFaction")
  outgoingRelations    EntityRelation[]   @relation("EntityRelationSource")
  incomingRelations    EntityRelation[]   @relation("EntityRelationTarget")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@unique([timelineId, materialRef])
  @@index([timelineId, type])
  @@map("entities")
}

model EntityRelation {
  id             String   @id @default(cuid())
  timelineId     String   @map("timeline_id")
