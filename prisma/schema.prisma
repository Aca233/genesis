  createdAt DateTime @default(now()) @map("created_at")

  @@index([abilityId, createdAt])
  @@index([chapterId])
  @@index([messageId])
  @@map("ability_events")
}

model EntityMembership {
  id          String  @id @default(cuid())
  characterId String  @map("character_id")
  character   Entity  @relation("MembershipCharacter", fields: [characterId], references: [id], onDelete: Cascade)
  factionId   String  @map("faction_id")
  faction     Entity  @relation("MembershipFaction", fields: [factionId], references: [id], onDelete: Cascade)
  role        String
  isPrimary   Boolean @default(false) @map("is_primary")

  @@unique([characterId, factionId])
  @@index([factionId])
  @@map("entity_memberships")
}

model EntitySection {
  id           String  @id @default(cuid())
  entityId     String  @map("entity_id")
  entity       Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  key          String // 栏目键，受类型模板约束
  content      Json
  revealed     Boolean @default(true) // false → 传闻/经卷残缺
  rumorText    String? @map("rumor_text") // 未揭示时的传闻（可误导）
  playerLocked Boolean @default(false) @map("player_locked")

  @@unique([entityId, key])
  @@map("entity_sections")
}

// ───────────────────────── 编年史 ─────────────────────────

model ChronicleEntry {
  id                String   @id @default(cuid())
  timelineId        String   @map("timeline_id")
  timeline          Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  chapterIndex      Int      @map("chapter_index")
  yearLabel         String   @map("year_label") // 主题卡纪年体系
  text              String // 史官笔法
  entityIds         String[] @map("entity_ids")
  godIds            String[] @map("god_ids")
  revealed          Boolean  @default(true) // false = 诸神隐藏行动
  revealedAtChapter Int?     @map("revealed_at_chapter")
  source            String   @default("narrative") // narrative | pantheon | manual
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([timelineId, chapterIndex])
  @@map("chronicle_entries")
}

// 将临之事：作者侧未来候选事件（时间一致世界生成设计稿 §5.3/§8 阶段3）。
// participantRefs 与 prerequisites/blockers/expectedConsequences 内的引用一律是
// 卡组稳定 ref（字符串），绝不落库 DB id——行因此可被克隆/导演内核零重映射携带。
model CanonEvent {
  id                   String   @id @default(cuid())
  timelineId           String   @map("timeline_id")
  timeline             Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  ref                  String
  title                String
  timeLabel            String   @map("time_label")
  ordinal              Int
  epoch                String   @default("future")
  summary              String   @db.Text
  participantRefs      String[] @map("participant_refs")
  prerequisites        Json
  blockers             Json?
  expectedConsequences Json?    @map("expected_consequences")
  status               String   @default("pending") // pending | eligible | altered | cancelled | occurred
  visibility           String   @default("author_only")
  divergenceNote       String?  @map("divergence_note")
  occurredChapterIndex Int?     @map("occurred_chapter_index")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([timelineId, ref])
  @@unique([timelineId, ordinal])
  @@index([timelineId, status])
  @@map("canon_events")
}

model OmenQueue {
  id         String   @id @default(cuid())
  timelineId String   @map("timeline_id")
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  godId      String   @map("god_id")
  text       String // 征兆：将润物细无声织入下章
  kind       String   @default("omen") // omen | proactive
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([timelineId, consumed])
  @@map("omen_queue")
}

// ───────────────────────── 世界书（ST 兼容）─────────────────────────

model LorebookEntry {
  id      String   @id @default(cuid())
  worldId String   @map("world_id")
  world   World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  keys    String[] // ST 触发词
  content String
  enabled Boolean  @default(true)
  stExtra Json?    @map("st_extra") // 保留 ST 原始字段，导出还原
  source  String   @default("imported") // imported | generated

  @@index([worldId])
  @@map("lorebook_entries")
}

// ───────────────────────── 资料索引 ─────────────────────────

// LoreIndexEntry：世界书条目的持久化分类索引（时间一致设计稿 §11 阶段4）。
// 索引是 LorebookEntry 之上的附加层，不是替换——ST 往返导出仍走 lorebook_entries。
// sourceKey = 条目内容的 SHA-256 哈希，跨世界、跨创世稳定，同一份资料只分类一次；
// 分类失败不落行，创世回退到原始条目截取，不阻断（§11）。
model LoreIndexEntry {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceKey     String   @map("source_key") // 条目内容 SHA-256 十六进制
  title         String
  keywords      String[]
  category      String // world_rule | timeline | character | faction | place | ability | other
  temporalHints Json     @map("temporal_hints") // { eraGuess: string, relativeToMainline: before|during|after|unknown }
  priority      Int      @default(50)
  excerpt       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, sourceKey])
  @@index([userId, category])
  @@map("lore_index_entries")
}

// ───────────────────────── 创世素材库 ─────────────────────────

model MaterialCard {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind             String
  name             String
  summary          String
  favorite         Boolean           @default(false)
  hidden           Boolean           @default(false)
  sourceWorldId    String?           @map("source_world_id")
  sourceWorld      World?            @relation(fields: [sourceWorldId], references: [id], onDelete: SetNull)
  sourceWorldName  String            @map("source_world_name")
  sourceKind       String            @map("source_kind")
  sourceRef        String            @map("source_ref")
  defaultVersionId String?           @map("default_version_id")
  versions         MaterialVersion[] @relation("MaterialCardVersions")
  defaultVersion   MaterialVersion?  @relation("MaterialDefaultVersion", fields: [defaultVersionId], references: [id], onDelete: SetNull)
  lastUsedAt       DateTime?         @map("last_used_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([userId, sourceKind, sourceRef])
  @@index([userId, favorite, hidden, updatedAt])
  @@index([sourceWorldId])
  @@map("material_cards")
}

model MaterialVersion {
  id              String            @id @default(cuid())
  cardId          String            @map("card_id")
  card            MaterialCard      @relation("MaterialCardVersions", fields: [cardId], references: [id], onDelete: Cascade)
  defaultForCards MaterialCard[]    @relation("MaterialDefaultVersion")
  version         Int
  name            String
  note            String?
  content         Json
  dependencies    Json
  schemaVersion   Int               @default(1) @map("schema_version")
  isInitial       Boolean           @default(false) @map("is_initial")
  parentVersionId String?           @map("parent_version_id")
  parentVersion   MaterialVersion?  @relation("MaterialVersionParents", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   MaterialVersion[] @relation("MaterialVersionParents")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([cardId, version])
  @@index([parentVersionId])
  @@map("material_versions")
}

// ───────────────────────── 设置与日志 ─────────────────────────

model Settings {
  userId        String   @id @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  narrativeSlot Json?    @map("narrative_slot") // ModelSlot（key 为 AES-256-GCM 密文）
  backstageSlot Json?    @map("backstage_slot")
  embeddingSlot Json?    @map("embedding_slot")
  prefs         Json? // 建议开关/翻章建议/烛光模式/文风预设
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model LlmCall {
  id                   String   @id @default(cuid())
  task                 String // narrative | genesis | settlement | reroll | pantheon | extract | chronicle | test
  slot                 String // narrative | backstage
  provider             String?
  model                String?
  durationMs           Int      @map("duration_ms")
  ok                   Boolean
  error                String?
  inputTokens          Int?     @map("input_tokens")
  outputTokens         Int?     @map("output_tokens")
  cacheReadTokens      Int?     @map("cache_read_tokens")
  cacheWriteTokens     Int?     @map("cache_write_tokens")
  cacheRequested       Boolean  @default(false) @map("cache_requested")
  cacheFallback        Boolean  @default(false) @map("cache_fallback")
  /**
   * 端点缓存能力降级快照(能力位 + 最近一次降级原因);全部完好为 NULL(F8 可观测)
   */
  cacheCapability      String?  @map("cache_capability")
  /**
   * 缓存前缀指纹(buildPromptCachePlan().key);同 hash 短窗口内第 2+ 次调用「应命中」(F5 可观测)
   */
  stablePrefixHash     String?  @map("stable_prefix_hash")
  /**
   * 一条业务请求(含全部续写/断点续传轮)共享的运行 ID(F5 可观测)
   */
  agentRunId           String?  @map("agent_run_id")
  /**
   * 运行内轮号:0 = 首轮请求,1+ = 续写接力/回退轮(F5 可观测)
   */
  agentCallIndex       Int?     @map("agent_call_index")
  /**
   * One business-level Gateway request shared by every physical Provider request.
   */
  logicalCallId        String?  @map("logical_call_id")
  /**
   * Zero-based index of the real Provider request within logicalCallId.
   */
  physicalAttemptIndex Int?     @map("physical_attempt_index")
  /**
   * stream | complete
   */
  transportKind        String?  @map("transport_kind")
  /**
   * Stable transport result classification; distinct from business validation.
   */
  transportOutcome     String?  @map("transport_outcome")
  /**
   * Evidence proving what is known about Provider-side termination.
   */
  terminalEvidence     String?  @map("terminal_evidence")
  /**
   * Stable machine-readable failure code; error remains the bounded redacted detail.
   */
  stableErrorCode      String?  @map("stable_error_code")
  dynamicTokens        Int?     @map("dynamic_tokens")
  toolResultTokens     Int?     @map("tool_result_tokens")
  cacheLayer           String?  @map("cache_layer")
  /**
   * 归因:发起调用的用户(多租户 Phase A);历史行保持 NULL 不回填
   */
  userId               String?  @map("user_id")
  /**
   * 归因:调用所属世界(设计 §3.1 顺手可加);无世界语境的调用(test 等)为 NULL
   */
  worldId              String?  @map("world_id")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([logicalCallId, physicalAttemptIndex])
  @@index([createdAt])
  @@index([task, createdAt])
  @@index([stablePrefixHash])
  @@index([agentRunId])
  @@index([logicalCallId])
  @@index([transportOutcome, createdAt])
  @@index([userId, createdAt])
  @@map("llm_calls")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  targetLabel String   @map("target_label")
  reason      String
  success     Boolean
  requestIp   String?  @map("request_ip")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}
