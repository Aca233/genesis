[Unit]
Description=Genesis encrypted PostgreSQL backup
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=genesis
Group=genesis
ExecStart=/srv/genesis/bin/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/genesis
ReadWritePaths=/srv/genesis/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
