# Database (docker-compose.yml defaults)
DATABASE_URL="postgresql://genesis:genesis_dev@localhost:5433/genesis"

# 32-byte hex secret for AES-256-GCM API-key encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY="replace-me"

# better-auth 会话密钥(生成:npx @better-auth/cli@1.4.21 secret,或复用上面 node 命令)
BETTER_AUTH_SECRET="replace-me"
# 站点外部 URL(生产填 https://<域名>)
BETTER_AUTH_URL="http://localhost:3000"
# 房主(管理员)user.id,逗号分隔;运行 auth-base-2-schema 的 seed-owner 后回填
ADMIN_USER_IDS=""

# Genesis V2 主引擎灰度。默认关闭并使用 7 月 24 日 legacy-v1；只有 ENABLED=true 时才读取百分比，白名单仍优先。
GENESIS_V2_PRIMARY_ENABLED="false"
GENESIS_V2_PRIMARY_PERCENT="0"
GENESIS_V2_PRIMARY_USER_IDS=""
# 仅为 legacy 任务附加低优先级 V2 对照，不写正式世界。
GENESIS_V2_SHADOW_ENABLED="false"

# Discord OAuth（两项必须同时配置；留空则不显示 Discord 注册/登录）
# Discord Developer Portal Redirect URI:
# http://localhost:3000/api/auth/callback/discord（生产把域名替换为 BETTER_AUTH_URL）
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# 生产加密异地备份（缺任一项时 backup.sh fail closed）
# age-keygen -o /etc/genesis/backup-age-key.txt 后，把输出的 age1... 公钥填入这里。
BACKUP_AGE_RECIPIENT=""
# rclone 远端目录，例如 s3:genesis-production/backups
BACKUP_RCLONE_REMOTE=""
